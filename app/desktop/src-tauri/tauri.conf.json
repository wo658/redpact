{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redpact",
  "version": "0.4.0",
  "identifier": "dev.redpact.desktop",
  "build": {
    "beforeDevCommand": "pnpm prepare:runtime",
    "beforeBuildCommand": "pnpm prepare:runtime",
    "frontendDist": "../placeholder"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../node_modules/.redpact/runtime/": "runtime/"
    },
    "macOS": {
      "minimumSystemVersion": "13.5"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": ""
    }
  }
}
