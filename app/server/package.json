{
  "name": "@redpact/server",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node tools/copy-assets.mjs && tsx src/main.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node tools/copy-assets.mjs",
    "start": "node dist/main.js",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@balena/dockerignore": "1.0.2",
    "@hono/node-server": "2.1.1",
    "@hono/zod-validator": "0.9.1",
    "@modelcontextprotocol/hono": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@parcel/watcher": "2.6.0",
    "commander": "15.0.0",
    "env-paths": "4.0.0",
    "execa": "10.0.1",
    "hono": "4.13.7",
    "hono-openapi": "1.3.2",
    "isomorphic-git": "1.41.9",
    "p-queue": "9.3.3",
    "pino": "10.3.1",
    "redoc": "2.5.3",
    "swagger-ui-dist": "5.32.15",
    "testcontainers": "12.1.0",
    "ts-morph": "28.0.0",
    "vitest": "4.0.18",
    "yaml": "2.9.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.0.0",
    "@types/node": "^24.13.3",
    "tsx": "4.23.13",
    "typescript": "~6.0.3"
  }
}
