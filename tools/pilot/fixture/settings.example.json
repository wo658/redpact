{
  "composeFiles": ["compose.yaml"],
  "services": ["app"],
  "dependencies": {},
  "tests": {
    "directory": "integration",
    "timeoutMs": 10000,
    "env": {
      "APP_URL": "http://app.redpact.test:3000"
    }
  },
  "playwright": {
    "directory": "ui-tests",
    "service": "app",
    "port": 3000,
    "locale": "ko-KR",
    "uiLanguage": "ko",
    "targets": {
      "functional": {
        "purpose": "functional",
        "scope": "worktree",
        "testMatch": ["baseline.spec.ts", "task.spec.ts"]
      },
      "capture": {
        "purpose": "capture",
        "scope": "worktree",
        "testMatch": ["capture.spec.ts"]
      }
    }
  }
}
